# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# The role you sell to (exact job titles) and who owns the stack there
ROLES=GTM Engineer,GTM Systems Engineer,GTM AI Engineer,Go-to-Market Engineer
OWNER_TITLES=Revenue Operations,RevOps,GTM Operations,Sales Operations,Head of Growth
SINCE_DAYS=30
COUNTRY=United States
HEADCOUNT=11-50,51-200,201-500

# Optional: Slack incoming webhook for alerts (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude drafts a first line per account (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
